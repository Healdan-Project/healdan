	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.logicaldoc</groupId>
		<artifactId>logicaldoc</artifactId>
		<version>9.3.2</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>healdan-web</artifactId>
	<name>healdan-web</name>
	<packaging>jar</packaging>
	<properties>
		<!-- -Dhealdan.web.skip=true builds the module without Node: the jar then holds no app, and AppServlet answers 503. -->
		<healdan.web.skip>false</healdan.web.skip>
	</properties>
	<dependencies>
