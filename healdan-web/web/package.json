{
  "name": "healdan-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../healdan-api/src/main/resources/healdan/api/openapi.yaml -o packages/api/src/schema.d.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run && node --test 'scripts/*.test.mjs'",
    "build": "npm run generate && npm run typecheck && npm run build --workspace @healdan/user"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
