# Keep the build context to sources. docker/ is needed, but the build stage copies it separately.
.git
.github
.claude
.superpowers
docs
# The docs site, with the build output and caches Hugo and its tests leave in it. docs-site.yml builds it.
site
**/target
**/gwt-unitCache
**/.settings
**/.project
**/.classpath
**/*.bak
# IDE and OS files: the build-stage COPY would see them change and re-run Maven.
**/.idea
**/*.iml
**/.vscode
**/.DS_Store
.env
.env.*
compose*.yaml
