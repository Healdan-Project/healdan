<?xml version="1.0" encoding="utf-8"?>
<!-- One package source, so central package management doesn't warn (NU1507) and a developer's own feeds don't leak in. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
