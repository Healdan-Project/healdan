<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app's own code that needs Avalonia to test; everything else is in Healdan.Helper.Core.Tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- CoreText's widths, for SystemFontTests, come through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="../Healdan.Helper/Healdan.Helper.csproj" />
  </ItemGroup>
</Project>
