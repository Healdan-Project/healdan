<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:Healdan.Helper.Core.Browse"
        xmlns:local="using:Healdan.Helper.Windows"
        x:Class="Healdan.Helper.Windows.SaveWindow"
        Title="Save to Healdan"
        Width="1000" Height="660" MinWidth="820" MinHeight="460"
        CanMinimize="False"
        WindowStartupLocation="CenterScreen">
  <!-- Save to Healdan (spec §5.8; mockup save-to-healdan.html, with the README's changes): places on the left, the place's
       contents in the middle, the new document's properties and its format on the right. -->
  <DockPanel>
    <Border x:Name="Toolbar" Classes="toolbar" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
        <TextBlock x:Name="WindowTitle" Classes="heading" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="False" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <Button x:Name="BackButton" Classes="tool" AutomationProperties.Name="Back">
            <local:IconView Data="{StaticResource Icon.chevron-left}" />
          </Button>
          <Button x:Name="ForwardButton" Classes="tool" AutomationProperties.Name="Forward">
            <local:IconView Data="{StaticResource Icon.chevron-right}" />
          </Button>
          <Button x:Name="UpButton" Classes="tool" AutomationProperties.Name="Up">
            <local:IconView Data="{StaticResource Icon.chevron-up}" />
          </Button>
        </StackPanel>
        <ComboBox x:Name="ScopePicker" Grid.Column="2" MinWidth="112" Margin="10,0,6,0" VerticalAlignment="Center" />
        <TextBox x:Name="SearchBox" Grid.Column="3" MinWidth="200" VerticalAlignment="Center">
          <TextBox.InnerLeftContent>
            <local:IconView Data="{StaticResource Icon.search}" Width="13" Height="13" Margin="6,0,0,0"
                            Foreground="{DynamicResource HdSecondaryBrush}" />
          </TextBox.InnerLeftContent>
        </TextBox>
      </Grid>
    </Border>
    <Border Classes="footer line" DockPanel.Dock="Bottom">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button x:Name="LocalButton" Classes="link" Content="Save to Local Computer…" VerticalAlignment="Center" />
        <Button x:Name="CancelButton" Grid.Column="2" Classes="footer" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="SaveButton" Grid.Column="3" Classes="footer accent" Content="Save" IsDefault="True" />
      </Grid>
    </Border>
    <Grid ColumnDefinitions="170,*,290">
      <Border x:Name="PlacesHost" Classes="nav" />

      <Border Grid.Column="1" Classes="pane">
        <DockPanel>
          <Border Classes="crumb" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True" />
              <Button x:Name="StarButton" Grid.Column="1" Classes="tool" AutomationProperties.Name="Add to Favorites">
                <local:IconView x:Name="StarIcon" Classes="star" Data="{StaticResource Icon.star}" />
              </Button>
              <Button x:Name="NewFolderButton" Grid.Column="2" Margin="6,0,0,0" AutomationProperties.Name="New Folder">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <local:IconView Data="{StaticResource Icon.folder-plus}" Width="14" Height="14" />
                  <TextBlock Text="New Folder" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <Border x:Name="NewFolderBar" Classes="crumb" DockPanel.Dock="Top" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox x:Name="NewFolderName" PlaceholderText="The new folder's name" />
              <Button x:Name="NewFolderCreate" Grid.Column="1" Classes="accent" Content="Create" Margin="6,0,0,0" />
              <Button x:Name="NewFolderCancel" Grid.Column="2" Content="Cancel" Margin="6,0,0,0" />
            </Grid>
          </Border>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="24,*,60,64,92" Margin="10,6,10,3">
            <TextBlock Grid.Column="1" Classes="column" Text="Title" />
            <TextBlock Grid.Column="2" Classes="column" Text="Version" />
            <TextBlock Grid.Column="3" Classes="column" Text="Doc #" />
            <TextBlock Grid.Column="4" Classes="column" Text="Edited" />
          </Grid>
          <TextBlock x:Name="NoticeText" DockPanel.Dock="Bottom" Classes="muted" Margin="12,6" TextWrapping="Wrap" IsVisible="False" />
          <ListBox x:Name="EntryList" Classes="rows">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="b:Entry">
                <Grid ColumnDefinitions="24,*,60,64,92">
                  <local:IconView Data="{Binding Icon, Converter={x:Static local:Icons.ByName}}" Classes="row-icon" Classes.folder="{Binding IsFolder}"
                                  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0" />
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasHolder}" Classes="holder" Classes.mine="{Binding HeldByMe}">
                      <local:IconView Data="{StaticResource Icon.lock}" Width="11" Height="11" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Holder}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Version}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="3" Text="{Binding DocNumber}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="4" Text="{Binding Edited}" Classes="muted" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="New Document Properties" Classes="heading" Margin="14,12,14,8" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,0,14,14" Spacing="9">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Name" Classes="label" />
                <TextBlock Text=" *" Classes="label required" />
              </StackPanel>
              <TextBox x:Name="NameBox" />
              <TextBlock x:Name="NameProblem" Classes="problem" IsVisible="False" />
            </StackPanel>
            <!-- A ContentControl clips to its bounds, which would cut a focused field's ring at the form's edges. -->
            <ContentControl x:Name="FormHost" ClipToBounds="False" />
            <TextBlock x:Name="FormNotice" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
            <StackPanel Spacing="2" Margin="0,4,0,0">
              <TextBlock Text="File Format" Classes="label" Margin="0,0,0,3" />
              <ComboBox x:Name="FormatPicker" HorizontalAlignment="Stretch" AutomationProperties.Name="File Format" />
              <TextBlock x:Name="FormatProblem" Classes="problem" IsVisible="False" Text="LibreOffice didn't say which formats it can save in." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
