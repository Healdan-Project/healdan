<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Healdan.Helper.Windows.CrashWindow"
        Title="Closed Unexpectedly"
        Width="480" SizeToContent="Height"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterScreen">
  <!-- After a Crash (spec §5.8, §5.10; the trial's window). -->
  <StackPanel Margin="20,18" Spacing="8">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <TextBlock x:Name="HintText" Classes="muted" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="CheckInButton" Classes="footer" Content="Send and Check In" />
      <Button x:Name="ReopenButton" Classes="footer accent" Content="Reopen" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
