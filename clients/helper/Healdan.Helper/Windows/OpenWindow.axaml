<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:Healdan.Helper.Core.Browse"
        xmlns:local="using:Healdan.Helper.Windows"
        x:Class="Healdan.Helper.Windows.OpenWindow"
        Title="Open from Healdan"
        Width="1000" Height="600" MinWidth="820" MinHeight="440"
        CanMinimize="False"
        WindowStartupLocation="CenterScreen">
  <!-- Open from Healdan (spec §5.8; mockup open-from-healdan.html): the same three panes as Save, defaulting to the
       Documents scope, with a document's thumbnail, properties and versions on the right. -->
  <DockPanel>
    <Border x:Name="Toolbar" Classes="toolbar" DockPanel.Dock="Top">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
        <TextBlock x:Name="WindowTitle" Classes="heading" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="False" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <Button x:Name="BackButton" Classes="tool" AutomationProperties.Name="Back">
            <local:IconView Data="{StaticResource Icon.chevron-left}" />
          </Button>
          <Button x:Name="ForwardButton" Classes="tool" AutomationProperties.Name="Forward">
            <local:IconView Data="{StaticResource Icon.chevron-right}" />
          </Button>
          <Button x:Name="UpButton" Classes="tool" AutomationProperties.Name="Up">
            <local:IconView Data="{StaticResource Icon.chevron-up}" />
          </Button>
        </StackPanel>
        <ComboBox x:Name="ScopePicker" Grid.Column="2" MinWidth="112" Margin="10,0,6,0" VerticalAlignment="Center" />
        <TextBox x:Name="SearchBox" Grid.Column="3" MinWidth="200" VerticalAlignment="Center">
          <TextBox.InnerLeftContent>
            <local:IconView Data="{StaticResource Icon.search}" Width="13" Height="13" Margin="6,0,0,0"
                            Foreground="{DynamicResource HdSecondaryBrush}" />
          </TextBox.InnerLeftContent>
        </TextBox>
      </Grid>
    </Border>
    <Border Classes="footer line" DockPanel.Dock="Bottom">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <Button x:Name="LocalButton" Classes="link" Content="Open from Local Computer…" VerticalAlignment="Center" />
        <CheckBox x:Name="ReadOnlyBox" Grid.Column="2" Content="Open Read-Only" Margin="0,0,14,0" VerticalAlignment="Center" />
        <Button x:Name="CancelButton" Grid.Column="3" Classes="footer" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="OpenButton" Grid.Column="4" Classes="footer accent" Content="Open" IsDefault="True" />
      </Grid>
    </Border>
    <Grid ColumnDefinitions="180,*,260">
      <Border x:Name="PlacesHost" Classes="nav" />

      <Border Grid.Column="1" Classes="pane">
        <DockPanel>
          <Border Classes="crumb" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True" />
              <Button x:Name="StarButton" Grid.Column="1" Classes="tool" AutomationProperties.Name="Add to Favorites">
                <local:IconView x:Name="StarIcon" Classes="star" Data="{StaticResource Icon.star}" />
              </Button>
            </Grid>
          </Border>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="24,*,56,52,58,84" Margin="10,6,10,3">
            <TextBlock Grid.Column="1" Classes="column" Text="Title" />
            <TextBlock Grid.Column="2" Classes="column" Text="Doc #" />
            <TextBlock Grid.Column="3" Classes="column" Text="Version" />
            <TextBlock Grid.Column="4" Classes="column" Text="Matter" />
            <TextBlock Grid.Column="5" Classes="column" Text="Edited" />
          </Grid>
          <TextBlock x:Name="NoticeText" DockPanel.Dock="Bottom" Classes="muted" Margin="12,6" TextWrapping="Wrap" IsVisible="False" />
          <ListBox x:Name="EntryList" Classes="rows">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="b:Entry">
                <Grid ColumnDefinitions="24,*,56,52,58,84">
                  <local:IconView Data="{Binding Icon, Converter={x:Static local:Icons.ByName}}" Classes="row-icon" Classes.folder="{Binding IsFolder}"
                                  VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0" />
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding HasHolder}" Classes="holder" Classes.mine="{Binding HeldByMe}">
                      <local:IconView Data="{StaticResource Icon.lock}" Width="11" Height="11" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Holder}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding DocNumber}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="3" Text="{Binding Version}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="4" Text="{Binding MatterText}" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="5" Text="{Binding Edited}" Classes="muted" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="2" Margin="14,12,14,10">
        <!-- The details pane (polish spec §6.2): a fixed header, then Properties and Versions. -->
        <StackPanel x:Name="DetailsHeader" DockPanel.Dock="Top" Spacing="10" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <local:IconView x:Name="DocIcon" Width="32" Height="32" Foreground="{DynamicResource HdAccentTextBrush}"
                            VerticalAlignment="Top" Margin="0,0,9,0" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock x:Name="DocTitle" Classes="heading" TextWrapping="Wrap" />
              <TextBlock x:Name="DocSubtitle" Classes="muted" FontSize="11" />
              <StackPanel x:Name="OlderLine" Orientation="Horizontal" Spacing="3" IsVisible="False">
                <local:IconView Data="{StaticResource Icon.eye}" Width="12" Height="12" Foreground="{DynamicResource HdCautionBrush}" />
                <TextBlock Text="Older version: opens read-only" FontSize="11" Foreground="{DynamicResource HdCautionTextBrush}" />
              </StackPanel>
            </StackPanel>
            <Button x:Name="DocStarButton" Grid.Column="2" Classes="tool" VerticalAlignment="Top" IsVisible="False" AutomationProperties.Name="Add to Favorites">
              <local:IconView x:Name="DocStarIcon" Classes="star" Data="{StaticResource Icon.star}" />
            </Button>
          </Grid>
          <ListBox x:Name="DetailTabs" Classes="segmented" SelectedIndex="0">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem Content="Properties" />
            <ListBoxItem x:Name="VersionsTab" Content="Versions" />
          </ListBox>
        </StackPanel>
        <TextBlock x:Name="DetailsNote" DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,40,0,0" Text="Choose a document to see its properties and versions." />
        <Panel Margin="0,10,0,0">
          <ScrollViewer x:Name="PropertiesTab" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
            <StackPanel Spacing="10">
              <Border x:Name="ThumbnailFrame" Classes="thumbnail" MaxHeight="140" HorizontalAlignment="Center" IsVisible="False">
                <Image x:Name="Thumbnail" Stretch="Uniform" />
              </Border>
              <TextBlock x:Name="KindNote" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="False"
                         Text="Only office documents can be edited from here: this one opens read-only." />
              <ItemsControl x:Name="DetailRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="b:Detail">
                    <Grid ColumnDefinitions="84,*" Margin="0,2">
                      <!-- An administrator can name a property anything; the 4 pt keeps a trimmed … (it overhangs its box) off the value. -->
                      <TextBlock Text="{Binding Label}" Classes="label" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <ListBox x:Name="VersionList" Classes="versions" IsVisible="False" />
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
