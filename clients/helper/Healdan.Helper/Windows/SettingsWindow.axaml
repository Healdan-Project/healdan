<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Healdan.Helper.Windows.SettingsWindow"
        Title="Healdan Helper Settings"
        Width="460" SizeToContent="Height"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterScreen">
  <!-- Settings (spec §5.8, §5.11, §5.12): the server's address, which app opens each kind of file, start at sign-in and the extension. -->
  <DockPanel>
    <Border Classes="footer" DockPanel.Dock="Bottom">
      <Button x:Name="DoneButton" Classes="footer accent" Content="Done" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" />
    </Border>
    <StackPanel Margin="20,16" Spacing="6">
      <TextBlock Text="Server" Classes="heading" />
      <TextBox x:Name="ServerBox" IsReadOnly="True" Classes="readonly" />
      <TextBlock x:Name="ServerNote" Classes="muted" TextWrapping="Wrap" FontSize="12" />
      <TextBlock Text="Open Each Kind of File In" Classes="heading" Margin="0,12,0,0" />
      <Grid x:Name="KindsGrid" ColumnDefinitions="*,170" RowDefinitions="Auto,Auto,Auto" />
      <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                 Text="Other files open read-only in the computer's default app." />
      <TextBlock Text="Start at Sign-In" Classes="heading" Margin="0,12,0,0" />
      <TextBlock x:Name="LoginItemLine" TextWrapping="Wrap" />
      <TextBlock Text="LibreOffice Extension" Classes="heading" Margin="0,12,0,0" />
      <TextBlock x:Name="ExtensionLine" TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>
</Window>
