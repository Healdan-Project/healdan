<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Healdan.Helper.Windows"
        x:Class="Healdan.Helper.Windows.SettingsWindow"
        Title="Healdan Helper Settings"
        Width="460" SizeToContent="Height"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        Background="{DynamicResource HdGroupedBrush}"
        WindowStartupLocation="CenterScreen">
  <!-- Settings (spec §5.8, §5.11, §5.12; polish spec §6.5; M3.5 spec §5.10): the server's address, which app opens each kind of
       file, Microsoft Office's Set Up and paired apps, start at sign-in and the extension, as grouped rows, as the Mac's System
       Settings. -->
  <StackPanel Margin="20,6,20,16">
    <TextBlock Text="Server" Classes="group-header" />
    <Border Classes="group">
      <!-- The address is the user's to type: its column takes what the label leaves and trims, where an Auto column would take all
           it asks for and leave the label none. -->
      <Grid Classes="row" ColumnDefinitions="Auto,Auto,*">
        <local:IconView Data="{StaticResource Icon.server}" Classes="folder" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="Address" VerticalAlignment="Center" Margin="0,0,12,0" />
        <SelectableTextBlock x:Name="ServerValue" Grid.Column="2" IsTabStop="False" Foreground="{DynamicResource HdSecondaryBrush}"
                             HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
    <TextBlock x:Name="ServerNote" Classes="footnote" />
    <TextBlock Text="Open Each Kind of File In" Classes="group-header" />
    <Border Classes="group">
      <StackPanel x:Name="KindsGroup" />
    </Border>
    <TextBlock Classes="footnote"
               Text="OpenDocument files open in LibreOffice whatever you choose, while it's installed. Other files open read-only in the computer's default app." />
    <!-- Microsoft Office (M3.5 spec §5.10): left out on a Mac with no Word, Excel or PowerPoint and no app paired. -->
    <TextBlock x:Name="OfficeHeader" Text="Microsoft Office" Classes="group-header" IsVisible="False" />
    <Border x:Name="OfficeGroup" Classes="group" IsVisible="False">
      <StackPanel>
        <Grid x:Name="SetUpRow" Classes="row" ColumnDefinitions="Auto,*,Auto">
          <local:IconView Data="{StaticResource Icon.lock}" Classes="folder" Margin="0,0,8,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Set Up" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                       Text="Trusts Healdan Helper's certificate, so Word, Excel and PowerPoint can reach it." />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse x:Name="SetUpDot" Width="7" Height="7" />
            <TextBlock x:Name="SetUpValue" Foreground="{DynamicResource HdSecondaryBrush}" VerticalAlignment="Center" />
            <Button x:Name="SetUpButton" Content="Set Up…" IsVisible="False" />
          </StackPanel>
        </Grid>
        <Border x:Name="PairedSection" Classes="divided">
          <StackPanel>
            <Grid Classes="row" ColumnDefinitions="Auto,*,Auto">
              <local:IconView Data="{StaticResource Icon.puzzle}" Classes="folder" Margin="0,0,8,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Paired Apps" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="An app you forget pairs again the next time you press a Healdan button in it." />
              </StackPanel>
              <TextBlock x:Name="PairedNone" Grid.Column="2" Text="None" Foreground="{DynamicResource HdSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
            <StackPanel x:Name="PairedList" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
    <TextBlock Text="This Computer" Classes="group-header" />
    <Border Classes="group">
      <StackPanel>
        <Grid x:Name="LoginRow" Classes="row" ColumnDefinitions="Auto,*,Auto">
          <local:IconView Data="{StaticResource Icon.power}" Classes="folder" Margin="0,0,8,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Start at Sign-In" />
            <TextBlock x:Name="LoginNote" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Ellipse x:Name="LoginDot" Width="7" Height="7" />
            <TextBlock x:Name="LoginValue" Foreground="{DynamicResource HdSecondaryBrush}" />
          </StackPanel>
        </Grid>
        <Border Classes="divided">
          <Grid x:Name="ExtensionRow" Classes="row" ColumnDefinitions="Auto,*,Auto">
            <local:IconView Data="{StaticResource Icon.puzzle}" Classes="folder" Margin="0,0,8,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="LibreOffice Extension" />
              <TextBlock x:Name="ExtensionNote" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock x:Name="ExtensionValue" Foreground="{DynamicResource HdSecondaryBrush}" VerticalAlignment="Center" />
              <Button x:Name="InstallButton" Content="Install…" IsVisible="False" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
    <Button x:Name="DoneButton" Classes="footer accent" Content="Done" IsDefault="True" IsCancel="True"
            HorizontalAlignment="Right" Margin="0,16,0,0" />
  </StackPanel>
</Window>
