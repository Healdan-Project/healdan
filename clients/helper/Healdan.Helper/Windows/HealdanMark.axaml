<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Healdan.Helper.Windows.HealdanMark">
  <!-- Healdan's mark (#89), redrawn shape for shape from the docs site's favicon.svg, as Avalonia doesn't read SVG: its
       260-point square, with the shapes offset by 22,5 and each group's clip a filled polyline. MarkTests checks it. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="260" Height="260">
      <Canvas Canvas.Left="22" Canvas.Top="5" Width="216" Height="250">
        <Path Data="M108,0 L0,30 L0,140 C0,200 50,232 108,250 Z" Fill="#0b5dab" />
        <Path Data="M108,0 L216,30 L216,140 C216,200 166,232 108,250 Z" Fill="#22a2e0" />
        <Polygon Points="88.00,36.00 177.00,66.00 177.00,170.00 88.00,136.00" Fill="#ffffff" />
        <Canvas Width="216" Height="250">
          <Canvas.Clip>
            <PolylineGeometry Points="58.00,43.65 159.00,77.69 159.00,194.35 58.00,156.31" IsFilled="True" />
          </Canvas.Clip>
          <Path Data="M108,0 L0,30 L0,140 C0,200 50,232 108,250 Z" Fill="#0b5dab" />
          <Path Data="M108,0 L216,30 L216,140 C216,200 166,232 108,250 Z" Fill="#22a2e0" />
        </Canvas>
        <Polygon Points="64.00,52.00 153.00,82.00 153.00,186.00 64.00,152.00" Fill="#ffffff" />
        <Canvas Width="216" Height="250">
          <Canvas.Clip>
            <PolylineGeometry Points="34.00,59.65 135.00,93.69 135.00,210.35 34.00,172.31" IsFilled="True" />
          </Canvas.Clip>
          <Path Data="M108,0 L0,30 L0,140 C0,200 50,232 108,250 Z" Fill="#0b5dab" />
          <Path Data="M108,0 L216,30 L216,140 C216,200 166,232 108,250 Z" Fill="#22a2e0" />
        </Canvas>
        <Polygon Points="40.00,68.00 129.00,98.00 129.00,202.00 40.00,168.00" Fill="#ffffff" />
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
