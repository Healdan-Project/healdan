<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Healdan.Helper.Windows.HeldElsewhereWindow"
        Title="Checked Out on Another Computer"
        Width="520" SizeToContent="Height"
        CanResize="False" CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterScreen">
  <!-- Checked Out on Another Computer (spec §5.10; the mockup's warning in open-from-healdan.html, in the owner's words). -->
  <StackPanel Margin="20,18" Spacing="8">
    <TextBlock x:Name="TitleText" Classes="title" TextWrapping="Wrap" />
    <TextBlock x:Name="LastSavedText" TextWrapping="Wrap" />
    <Border Classes="warn" Margin="0,2,0,0">
      <StackPanel Spacing="4">
        <TextBlock x:Name="EmphasisText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="ReadOnlyButton" Classes="footer" Content="Open Read-Only" />
      <Button x:Name="EditHereButton" Classes="footer" Content="Edit Here Instead" />
      <Button x:Name="CancelButton" Classes="footer accent" Content="Cancel" IsCancel="True" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
