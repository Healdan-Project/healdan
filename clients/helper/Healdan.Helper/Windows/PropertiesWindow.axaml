<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Healdan.Helper.Windows"
        x:Class="Healdan.Helper.Windows.PropertiesWindow"
        Title="Properties"
        Width="440" Height="600" MinWidth="380" MinHeight="360"
        CanMinimize="False" CanMaximize="False"
        WindowStartupLocation="CenterScreen">
  <!-- Properties (spec §5.5, §5.8): the same form as Save's right pane, for the open document. -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="20,16,20,4">
      <local:IconView x:Name="DocIcon" Width="32" Height="32" Foreground="{DynamicResource HdAccentTextBrush}"
                      Data="{StaticResource Icon.file-text}" VerticalAlignment="Top" Margin="0,0,9,0" />
      <StackPanel Grid.Column="1" Spacing="1">
        <TextBlock x:Name="DocTitle" Classes="heading" TextWrapping="Wrap" />
        <TextBlock x:Name="Subtitle" Classes="muted" FontSize="11" Text="Document Properties" />
      </StackPanel>
    </Grid>
    <Border Classes="footer" DockPanel.Dock="Bottom">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="ProblemText" Classes="problem" VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="False" />
        <Button x:Name="CancelButton" Grid.Column="1" Classes="footer" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="SaveButton" Grid.Column="2" Classes="footer accent" Content="Save" IsDefault="True" />
      </Grid>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,8,20,12" Spacing="8">
        <TextBlock x:Name="NoteText" Classes="muted" TextWrapping="Wrap" Text="Loading the properties…" />
        <!-- A ContentControl clips to its bounds, which would cut a focused field's ring at the form's edges. -->
        <ContentControl x:Name="FormHost" ClipToBounds="False" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
