<?xml version="1.0" encoding="UTF-8"?>
<!-- The Healdan menu's and toolbar's commands go to healdan.py's Handler. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="ProtocolHandler" oor:package="org.openoffice.Office">
  <node oor:name="HandlerSet">
    <node oor:name="org.healdan.libreoffice.ProtocolHandler" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>org.healdan.libreoffice:*</value>
      </prop>
    </node>
  </node>
</oor:component-data>
