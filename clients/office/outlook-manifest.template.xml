<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Healdan add-in's manifest for Outlook. healdan-api's AddinResource serves it at /api/addin/outlook-manifest.xml,
  replacing the two placeholders in double braces with the server's address, as it does for manifest.template.xml, so
  each firm uploads a manifest that points at itself. BASE is that address and /api/addin; ORIGIN is the address alone.
  (Keep the placeholders out of this comment: an address with two hyphens in a row can't go in one.)

  The Id never changes. Raise Version in any change to this file, or the admin centre keeps the old manifest.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>dc3a8a30-e0a3-4f98-b324-bb2016f68f9e</Id>
  <Version>1.0.1.0</Version>
  <ProviderName>Healdan</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Healdan"/>
  <Description DefaultValue="See whether a message is in Healdan, and file it into a matter."/>
  <IconUrl DefaultValue="{{BASE}}/assets/healdan-64.png"/>
  <HighResolutionIconUrl DefaultValue="{{BASE}}/assets/healdan-128.png"/>
  <SupportUrl DefaultValue="https://docs.healdan.com/user/office/"/>
  <AppDomains>
    <AppDomain>{{ORIGIN}}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="{{BASE}}/mail.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="healdanGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="healdanButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Pane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="{{BASE}}/assets/file-email-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="{{BASE}}/assets/file-email-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="{{BASE}}/assets/file-email-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Pane.Url" DefaultValue="{{BASE}}/mail.html?v=1_0"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Healdan"/>
        <bt:String id="Button.Label" DefaultValue="Healdan"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="See whether this message is in Healdan, and file it."/>
      </bt:LongStrings>
    </Resources>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.13">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="healdanGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="healdanButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Pane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="{{BASE}}/assets/file-email-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="{{BASE}}/assets/file-email-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="{{BASE}}/assets/file-email-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Pane.Url" DefaultValue="{{BASE}}/mail.html?v=1_1"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Healdan"/>
          <bt:String id="Button.Label" DefaultValue="Healdan"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="See whether this message is in Healdan, and file it."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
