<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Healdan add-in's manifest for Word, Excel and PowerPoint. healdan-api's AddinResource serves it at
  /api/addin/manifest.xml, replacing the two placeholders in double braces with the server's address, so each firm
  uploads a manifest that points at itself. BASE is that address and /api/addin; ORIGIN is the address alone.
  (Keep the placeholders out of this comment: an address with two hyphens in a row can't go in one.)

  The Id never changes. Raise Version in any change to this file, or the admin centre keeps the old manifest.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">
  <Id>7b0f3a52-8d1e-4c4b-9a6e-2f5d0c8e4a91</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Healdan</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Healdan"/>
  <Description DefaultValue="Save to and open from Healdan in Word, Excel and PowerPoint."/>
  <IconUrl DefaultValue="{{BASE}}/assets/healdan-32.png"/>
  <HighResolutionIconUrl DefaultValue="{{BASE}}/assets/healdan-64.png"/>
  <SupportUrl DefaultValue="https://docs.healdan.com/user/office/"/>
  <AppDomains>
    <AppDomain>{{ORIGIN}}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
    <Host Name="Workbook"/>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="{{BASE}}/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
