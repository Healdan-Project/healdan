        <bt:Image id="Mark.Icon16" DefaultValue="{{BASE}}/assets/healdan-16.png"/>
        <bt:Image id="Mark.Icon32" DefaultValue="{{BASE}}/assets/healdan-32.png"/>
        <bt:Image id="Mark.Icon80" DefaultValue="{{BASE}}/assets/healdan-80.png"/>
        <bt:Image id="SaveToHealdan.Icon16" DefaultValue="{{BASE}}/assets/save-to-healdan-16.png"/>
        <bt:Image id="SaveToHealdan.Icon32" DefaultValue="{{BASE}}/assets/save-to-healdan-32.png"/>
        <bt:Image id="SaveToHealdan.Icon80" DefaultValue="{{BASE}}/assets/save-to-healdan-80.png"/>
        <bt:Image id="OpenFromHealdan.Icon16" DefaultValue="{{BASE}}/assets/open-from-healdan-16.png"/>
