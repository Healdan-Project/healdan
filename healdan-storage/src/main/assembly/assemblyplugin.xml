<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
	<id>plugin</id>
	<formats>
		<format>zip</format>
	</formats>
	<includeBaseDirectory>false</includeBaseDirectory>
	<dependencySets>
		<dependencySet>
			<outputDirectory>WEB-INF/lib</outputDirectory>
			<!-- Left out on purpose, because the WAR ships them or nothing here loads them: reactive-streams 1.0.4 (the same
				version, through Infinispan), protobuf-java and error_prone_annotations (the WAR has 4.29.0 and 2.18.0/2.28.0;
				Tink's streaming AEAD loads neither protobuf nor Gson, which TinkClasspathTest proves), and Gson -->
			<includes>
				<include>com.logicaldoc:healdan-storage</include>
				<include>software.amazon.awssdk:*</include>
				<include>software.amazon.eventstream:*</include>
				<include>com.google.crypto.tink:*</include>
			</includes>
			<outputFileNameMapping>
				${artifact.artifactId}-${artifact.version}-plugin.${artifact.type}</outputFileNameMapping>
		</dependencySet>
	</dependencySets>
	<fileSets>
		<fileSet>
			<directory>src/main/resources/</directory>
			<outputDirectory>/</outputDirectory>
			<includes>
				<include>plugin.xml</include>
			</includes>
			<useDefaultExcludes>true</useDefaultExcludes>
		</fileSet>
	</fileSets>
</assembly>
