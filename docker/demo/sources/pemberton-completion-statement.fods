      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="RowNum" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NNum"/>
    <style:style style:name="RowInt" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NInt">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="RowMoney" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NGBP"/>
    <style:style style:name="RowMoneyIn" style:family="table-cell" style:parent-style-name="RowMoney">
      <style:text-properties fo:color="#0b3d91"/>
    </style:style>
    <style:style style:name="RowPct" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NPct"/>
    <style:style style:name="RowPctIn" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NPct">
      <style:text-properties fo:color="#0b3d91"/>
    </style:style>
    <style:style style:name="RowDate" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NDate">
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="RowDateIn" style:family="table-cell" style:parent-style-name="RowDate">
      <style:text-properties fo:color="#0b3d91"/>
    </style:style>
    <style:style style:name="HiRow" style:family="table-cell" style:parent-style-name="Row">
      <style:table-cell-properties fo:background-color="#fff3d1"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="HiMoney" style:family="table-cell" style:parent-style-name="HiRow" style:data-style-name="NGBP"/>
    <style:style style:name="HiPct" style:family="table-cell" style:parent-style-name="HiRow" style:data-style-name="NPct"/>
    <style:style style:name="Sub" style:family="table-cell" style:parent-style-name="Default">
      <style:table-cell-properties fo:border-top="0.75pt solid #000000" fo:padding="0.08cm" fo:wrap-option="wrap"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="SubMoney" style:family="table-cell" style:parent-style-name="Sub" style:data-style-name="NGBP"/>
    <style:style style:name="SubPct" style:family="table-cell" style:parent-style-name="Sub" style:data-style-name="NPct"/>
    <style:style style:name="Total" style:family="table-cell" style:parent-style-name="Default">
      <style:table-cell-properties fo:background-color="#e6eef0" fo:border-top="0.75pt solid #1d4e5f" fo:border-bottom="1.5pt double #1d4e5f" fo:padding="0.08cm" fo:wrap-option="wrap"/>
      <style:text-properties fo:font-size="10.5pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="TotalMoney" style:family="table-cell" style:parent-style-name="Total" style:data-style-name="NGBP"/>
    <style:style style:name="TotalPct" style:family="table-cell" style:parent-style-name="Total" style:data-style-name="NPct"/>
    <style:style style:name="Due" style:family="table-cell" style:parent-style-name="Default">
      <style:table-cell-properties fo:background-color="#1d4e5f" fo:padding="0.1cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold" fo:color="#ffffff"/>
    </style:style>
    <style:style style:name="DueMoney" style:family="table-cell" style:parent-style-name="Due" style:data-style-name="NGBP">
