  <office:automatic-styles>
    <style:style style:name="co0" style:family="table-column"><style:table-column-properties style:column-width="11.9cm"/></style:style><style:style style:name="co1" style:family="table-column"><style:table-column-properties style:column-width="4.0cm"/></style:style>
    <style:style style:name="rh1_45" style:family="table-row"><style:table-row-properties style:row-height="1.45cm" style:use-optimal-row-height="false"/></style:style><style:style style:name="rh1_15" style:family="table-row"><style:table-row-properties style:row-height="1.15cm" style:use-optimal-row-height="false"/></style:style><style:style style:name="rh0_8" style:family="table-row"><style:table-row-properties style:row-height="0.8cm" style:use-optimal-row-height="false"/></style:style><style:style style:name="rh1_46" style:family="table-row"><style:table-row-properties style:row-height="1.46cm" style:use-optimal-row-height="false"/></style:style><style:style style:name="rh1_04" style:family="table-row"><style:table-row-properties style:row-height="1.04cm" style:use-optimal-row-height="false"/></style:style>
    <style:page-layout style:name="pm1">
