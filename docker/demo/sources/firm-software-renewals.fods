  <office:body>
    <office:spreadsheet>
      <table:table table:name="Renewals">
        <table:table-column table:style-name="co0"/><table:table-column table:style-name="co1"/><table:table-column table:style-name="co2"/><table:table-column table:style-name="co3"/><table:table-column table:style-name="co4"/><table:table-column table:style-name="co5"/><table:table-column table:style-name="co6"/><table:table-column table:style-name="co7"/>
                <table:table-row table:style-name="rh0_9"><table:table-cell table:style-name="Title" table:number-columns-spanned="8" office:value-type="string"><text:p>Ashcombe Reeve LLP – software and renewals register</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Heading" table:number-columns-spanned="8" office:value-type="string"><text:p>Kept by Sam Okafor, IT and Office Manager</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" office:value-type="string"><text:p>As at</text:p></table:table-cell><table:table-cell table:style-name="RowDateShortIn" office:value-type="date" office:date-value="2026-10-01"><text:p>1 Oct 2026</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="6"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="5"/></table:table-row>
        <table:table-row table:style-name="rh1_0"><table:table-cell table:style-name="NoteWrap" table:number-columns-spanned="8" office:value-type="string"><text:p>Blue figures and dates are inputs; the rest are worked out. Days to renewal count from the as-at date. Yearly costs are before VAT where it applies.</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="8"/></table:table-row>
        <table:table-row table:style-name="rh1_0"><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p>System</text:p></table:table-cell><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p>Supplier</text:p></table:table-cell><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p>Phone</text:p></table:table-cell><table:table-cell table:style-name="ColHeadRight" office:value-type="string"><text:p>Yearly cost</text:p></table:table-cell><table:table-cell table:style-name="ColHeadCentre" office:value-type="string"><text:p>Renewal date</text:p></table:table-cell><table:table-cell table:style-name="ColHeadCentre" office:value-type="string"><text:p>Notice</text:p></table:table-cell><table:table-cell table:style-name="ColHeadRight" office:value-type="string"><text:p>Days to renewal</text:p></table:table-cell><table:table-cell table:style-name="ColHeadPad" office:value-type="string"><text:p>Notes</text:p></table:table-cell></table:table-row>
