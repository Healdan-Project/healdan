<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ashcombe Reeve LLP's software and renewals register as at 1 October 2026, kept by Sam Okafor (998.2 Documents). Every result is
  a real formula, and each formula cell also carries the value it works out to (office:value), which LibreOffice shows until it
  recalculates. If a figure or a date changes, change the cached values beside it. The sums, for checking by hand:

    a year  0 + 380 + 1,080 + 2,520 + 3,600 + 420 + 1,260 + 24 + 180 + 310 = 9,774.00; a month 9,774.00 / 12 = 814.50
    days to renewal  the renewal date less 1 October 2026 (Tallyfold Practice, 1 November 2026: 31 days; the next renewal)
-->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0"
  xmlns:number="urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  xmlns:of="urn:oasis:names:tc:opendocument:xmlns:of:1.2"
  office:version="1.3"
  office:mimetype="application/vnd.oasis.opendocument.spreadsheet">

  <office:meta>
    <meta:initial-creator>Sam Okafor</meta:initial-creator>
    <dc:creator>Sam Okafor</dc:creator>
    <dc:title>Software and Renewals Register</dc:title>
    <dc:language>en-GB</dc:language>
    <meta:creation-date>2026-09-30T15:20:00</meta:creation-date>
    <dc:date>2026-10-01T09:45:00</dc:date>
  </office:meta>

  <office:font-face-decls>
    <style:font-face style:name="Calibri" svg:font-family="Calibri" style:font-family-generic="swiss" style:font-pitch="variable"/>
  </office:font-face-decls>

  <office:styles>
    <style:default-style style:family="table-cell">
      <style:text-properties style:font-name="Calibri" fo:font-size="9.5pt" fo:language="en" fo:country="GB"/>
      <style:table-cell-properties style:vertical-align="middle"/>
    </style:default-style>

    <number:number-style style:name="NNum">
      <number:number number:decimal-places="1" number:min-decimal-places="0" number:min-integer-digits="1"/>
    </number:number-style>
    <number:number-style style:name="NInt">
      <number:number number:decimal-places="0" number:min-integer-digits="1"/>
    </number:number-style>
    <number:currency-style style:name="NGBP">
      <number:currency-symbol number:language="en" number:country="GB">£</number:currency-symbol>
      <number:number number:decimal-places="2" number:min-decimal-places="2" number:min-integer-digits="1" number:grouping="true"/>
    </number:currency-style>
    <number:percentage-style style:name="NPct">
      <number:number number:decimal-places="1" number:min-decimal-places="0" number:min-integer-digits="1"/>
      <number:text>%</number:text>
    </number:percentage-style>
    <number:date-style style:name="NDate">
      <number:day/><number:text> </number:text><number:month number:textual="true"/><number:text> </number:text><number:year number:style="long"/>
    </number:date-style>

    <style:style style:name="Default" style:family="table-cell"/>
    <style:style style:name="Title" style:family="table-cell" style:parent-style-name="Default">
