        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="3" office:value-type="string"><text:p>Weekly loss in the new job (net pay less new pay)</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/><table:table-cell table:style-name="RowMoney" table:formula="of:=[.D7]-[.D9]" office:value-type="currency" office:currency="GBP" office:value="60.0"><text:p>£60.00</text:p></table:table-cell><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Default" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row>
