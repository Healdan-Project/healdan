        <table:table-row table:style-name="rowStd"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Loss of statutory rights</text:p></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="500.0"><text:p>£500.00</text:p></table:table-cell><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="400.0"><text:p>£400.00</text:p></table:table-cell></table:table-row>
