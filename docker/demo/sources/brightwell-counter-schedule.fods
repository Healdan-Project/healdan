        <table:table-row table:style-name="rowStd"><table:table-cell table:style-name="Sub" office:value-type="string"><text:p>Compensatory award, as reduced</text:p></table:table-cell><table:table-cell table:style-name="Sub"><text:p/></table:table-cell><table:table-cell table:style-name="Sub"><text:p/></table:table-cell><table:table-cell table:style-name="SubMoney" table:formula="of:=[.D18]+[.D19]" office:value-type="currency" office:currency="GBP" office:value="8680.0"><text:p>£8,680.00</text:p></table:table-cell><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Sub"><text:p/></table:table-cell><table:table-cell table:style-name="Sub"><text:p/></table:table-cell><table:table-cell table:style-name="SubMoney" table:formula="of:=[.H18]+[.H19]" office:value-type="currency" office:currency="GBP" office:value="2337.0"><text:p>£2,337.00</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="row2"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Reduction for his own conduct, taken off both awards (note 3)</text:p></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="RowPctIn" office:value-type="percentage" office:value="0.0"><text:p>0%</text:p></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="RowPctIn" office:value-type="percentage" office:value="0.5"><text:p>50%</text:p></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="rowStd"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Basic award after conduct</text:p></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.D14]-ROUND([.D14]*[.C21];2)" office:value-type="currency" office:currency="GBP" office:value="3780.0"><text:p>£3,780.00</text:p></table:table-cell><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.H14]-ROUND([.H14]*[.G21];2)" office:value-type="currency" office:currency="GBP" office:value="1890.0"><text:p>£1,890.00</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="rowStd"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Compensatory award after conduct</text:p></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.D20]-ROUND([.D20]*[.C21];2)" office:value-type="currency" office:currency="GBP" office:value="8680.0"><text:p>£8,680.00</text:p></table:table-cell><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.H20]-ROUND([.H20]*[.G21];2)" office:value-type="currency" office:currency="GBP" office:value="1168.5"><text:p>£1,168.50</text:p></table:table-cell></table:table-row>
