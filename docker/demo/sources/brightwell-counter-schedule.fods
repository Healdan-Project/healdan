        <table:table-row table:style-name="rowNote3"><table:table-cell table:style-name="NoteWrap" table:number-columns-spanned="8" office:value-type="string"><text:p>Employment Tribunal case no. 9900417/2026. Prepared by Jamie Clarke, Ashcombe Reeve LLP (ref TR/1002.2/JC), 19 October 2026. The claimant’s figures are as he claims them. The respondent’s are what it would allow if the dismissal were found unfair; it says that it was fair.</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="8"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Section" table:number-columns-spanned="4" office:value-type="string"><text:p>The facts the figures rest on</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="3"/><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Default" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="3" office:value-type="string"><text:p>Gross weekly pay</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="540.0"><text:p>£540.00</text:p></table:table-cell><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Default" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="3" office:value-type="string"><text:p>Net weekly pay</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="440.0"><text:p>£440.00</text:p></table:table-cell><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Default" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="3" office:value-type="string"><text:p>Complete years’ service (3 April 2019 to 12 June 2026)</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/><table:table-cell table:style-name="RowNumIn" office:value-type="float" office:value="7.0"><text:p>7</text:p></table:table-cell><table:table-cell table:style-name="Default"><text:p/></table:table-cell><table:table-cell table:style-name="Default" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row>
