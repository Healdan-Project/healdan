  <office:body>
    <office:spreadsheet>
      <table:table table:name="Appraisals">
        <table:table-column table:style-name="co0"/><table:table-column table:style-name="co1"/><table:table-column table:style-name="co2"/><table:table-column table:style-name="co3"/><table:table-column table:style-name="co4"/><table:table-column table:style-name="co5"/><table:table-column table:style-name="co6"/>
                <table:table-row table:style-name="rh0_9"><table:table-cell table:style-name="Title" table:number-columns-spanned="7" office:value-type="string"><text:p>Appraisals and salary review 2026</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Heading" table:number-columns-spanned="7" office:value-type="string"><text:p>As at 24 September 2026 – for the partners only</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row table:style-name="rh1_3"><table:table-cell table:style-name="NoteWrap" table:number-columns-spanned="7" office:value-type="string"><text:p>Prepared by Tom Reeve. Each self-assessment is due a week before its appraisal. Blue figures are inputs; the rest are worked out. The guide is each salary’s share of the overall budget, and the partners will settle the actual figures after the appraisals.</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Section" table:number-columns-spanned="7" office:value-type="string"><text:p>Timetable and review budget</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="3" office:value-type="string"><text:p>Days before the appraisal that the self-assessment is due</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/><table:table-cell table:style-name="RowCount" office:value-type="float" office:value="7.0"><text:p>7</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="3" office:value-type="string"><text:p>Overall budget, as a percentage of current salaries</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/><table:table-cell table:style-name="RowPct2" office:value-type="percentage" office:value="0.06"><text:p>6.00%</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="3" office:value-type="string"><text:p>Date the review takes effect</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/><table:table-cell table:style-name="RowDateShortIn" office:value-type="date" office:date-value="2026-11-01"><text:p>1 Nov 2026</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row>
