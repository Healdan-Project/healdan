    </style:style>
    <style:style style:name="Row" style:family="table-cell" style:parent-style-name="Default">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #cccccc" fo:padding="0.08cm" fo:wrap-option="wrap"/>
    </style:style>
    <style:style style:name="RowText" style:family="table-cell" style:parent-style-name="Default">
      <style:table-cell-properties fo:border-bottom="0.5pt solid #cccccc" fo:padding-top="0.08cm" fo:padding-bottom="0.08cm" fo:padding-left="0.3cm" fo:padding-right="0.08cm"/>
    </style:style>
    <style:style style:name="RowCentre" style:family="table-cell" style:parent-style-name="Row">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="RowDays" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NDays4"/>
    <style:style style:name="RowDays2" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NDays2"/>
    <style:style style:name="RowUSD" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NUSD"/>
    <style:style style:name="RowDT" style:family="table-cell" style:parent-style-name="Row" style:data-style-name="NDT">
      <style:paragraph-properties fo:text-align="start"/>
    </style:style>
    <style:style style:name="RowDTIn" style:family="table-cell" style:parent-style-name="RowDT">
      <style:text-properties fo:color="#0b3d91"/>
    </style:style>
    <style:style style:name="Sub" style:family="table-cell" style:parent-style-name="Default">
      <style:table-cell-properties fo:border-top="0.75pt solid #000000" fo:padding="0.08cm"/>
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="SubDays" style:family="table-cell" style:parent-style-name="Sub" style:data-style-name="NDays4"/>
    <style:style style:name="SubDays2" style:family="table-cell" style:parent-style-name="Sub" style:data-style-name="NDays2"/>
    <style:style style:name="Total" style:family="table-cell" style:parent-style-name="Default">
      <style:table-cell-properties fo:background-color="#e6eef0" fo:border-top="0.75pt solid #1d4e5f" fo:border-bottom="1.5pt double #1d4e5f" fo:padding="0.08cm"/>
      <style:text-properties fo:font-size="10.5pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="TotalUSD" style:family="table-cell" style:parent-style-name="Total" style:data-style-name="NUSD"/>
    <style:style style:name="Diff" style:family="table-cell" style:parent-style-name="Default">
      <style:table-cell-properties fo:background-color="#1d4e5f" fo:padding="0.1cm"/>
      <style:text-properties fo:font-size="11pt" fo:font-weight="bold" fo:color="#ffffff"/>
      <style:paragraph-properties fo:text-align="end"/>
    </style:style>
    <style:style style:name="DiffUSD" style:family="table-cell" style:parent-style-name="Diff" style:data-style-name="NUSD"/>
  </office:styles>

  <office:automatic-styles>
    <style:style style:name="coA" style:family="table-column"><style:table-column-properties style:column-width="4.4cm"/></style:style>
    <style:style style:name="coB" style:family="table-column"><style:table-column-properties style:column-width="2.8cm"/></style:style>
    <style:style style:name="coD" style:family="table-column"><style:table-column-properties style:column-width="2.6cm"/></style:style>
    <style:style style:name="coE" style:family="table-column"><style:table-column-properties style:column-width="0.3cm"/></style:style>
    <style:style style:name="coF" style:family="table-column"><style:table-column-properties style:column-width="5.5cm"/></style:style>
    <style:style style:name="coI" style:family="table-column"><style:table-column-properties style:column-width="1.3cm"/></style:style>
