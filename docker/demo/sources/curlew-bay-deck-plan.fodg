<?xml version="1.0" encoding="UTF-8"?>
<!--
  The general arrangement of the MV Curlew Bay for 1001.2 (Vessel Sale), drawn by Saltmarsh Shipping Ltd's
  operations team for the buyer's inspection on 8 October 2026. A4 landscape, simple labelled shapes, not to scale.
  Particulars: built 2009, length overall 89.95 m, beam 13.20 m, deadweight 4,100 tonnes, gearless.
-->
<office:document
