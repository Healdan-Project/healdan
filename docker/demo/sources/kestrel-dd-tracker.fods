  <office:body>
    <office:spreadsheet>
      <table:table table:name="Due diligence">
        <table:table-column table:style-name="co0"/><table:table-column table:style-name="co1"/><table:table-column table:style-name="co2"/><table:table-column table:style-name="co3"/><table:table-column table:style-name="co4"/><table:table-column table:style-name="co5"/><table:table-column table:style-name="co6"/>
                <table:table-row table:style-name="rh0_9"><table:table-cell table:style-name="Title" table:number-columns-spanned="7" office:value-type="string"><text:p>Kestrel Software Ltd – Series A due diligence tracker</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Heading" table:number-columns-spanned="7" office:value-type="string"><text:p>Updated 28 September 2026</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row table:style-name="rh1_0"><table:table-cell table:style-name="NoteWrap" table:number-columns-spanned="7" office:value-type="string"><text:p>Prepared by Priya Nair for Helen Ashcombe (matter 1003.1). The requests are those of Brindley Moss LLP’s list of 21 September 2026. With is who provides the item. Status is Done, With client (the company has the next step) or Open (not yet started or not yet found).</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row table:style-name="rh0_8"><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p>Ref</text:p></table:table-cell><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p>Area</text:p></table:table-cell><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p>Request</text:p></table:table-cell><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p>With</text:p></table:table-cell><table:table-cell table:style-name="ColHeadCentre" office:value-type="string"><text:p>Status</text:p></table:table-cell><table:table-cell table:style-name="ColHeadCentre" office:value-type="string"><text:p>Date provided</text:p></table:table-cell><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p>Notes</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>DD01</text:p></table:table-cell><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>Corporate</text:p></table:table-cell><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>Certificate of incorporation and current articles of association</text:p></table:table-cell><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>Ines Kowalczyk</text:p></table:table-cell><table:table-cell table:style-name="StDone" office:value-type="string"><text:p>Done</text:p></table:table-cell><table:table-cell table:style-name="RowDateTop" office:value-type="date" office:date-value="2026-09-22"><text:p>22 Sep 2026</text:p></table:table-cell><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>In the data room.</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>DD02</text:p></table:table-cell><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>Corporate</text:p></table:table-cell><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>Registers of members, directors and people with significant control; share certificates</text:p></table:table-cell><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>Ines Kowalczyk</text:p></table:table-cell><table:table-cell table:style-name="StDone" office:value-type="string"><text:p>Done</text:p></table:table-cell><table:table-cell table:style-name="RowDateTop" office:value-type="date" office:date-value="2026-09-24"><text:p>24 Sep 2026</text:p></table:table-cell><table:table-cell table:style-name="RowTop" office:value-type="string"><text:p>Agree with the cap table: 9,000,000 ordinary shares.</text:p></table:table-cell></table:table-row>
