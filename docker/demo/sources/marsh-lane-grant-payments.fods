  <office:body>
    <office:spreadsheet>
      <table:table table:name="Payments and budget">
        <table:table-column table:style-name="co0"/><table:table-column table:style-name="co1"/><table:table-column table:style-name="co2"/><table:table-column table:style-name="co3"/><table:table-column table:style-name="co4"/><table:table-column table:style-name="co5"/><table:table-column table:style-name="co6"/>
                <table:table-row table:style-name="rh0_9"><table:table-cell table:style-name="Title" table:number-columns-spanned="7" office:value-type="string"><text:p>Marsh Lane Community Trust – Wexmoor Foundation grant: payments and budget</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Heading" table:number-columns-spanned="7" office:value-type="string"><text:p>The Marsh Lane Youth Centre evening programme, 1 January 2027 to 31 December 2029</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row table:style-name="rh1_15"><table:table-cell table:style-name="NoteWrap" table:number-columns-spanned="7" office:value-type="string"><text:p>Prepared by Jamie Clarke, Ashcombe Reeve LLP (ref HA/1004.1/JC), on 1 October 2026 from the draft grant agreement of 24 September 2026. The grant is £90,000 in six half-yearly instalments of £15,000. Each instalment after the first is paid only once the progress report due a month before it has been accepted. Blue figures are inputs; the rest are worked out.</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Section" table:number-columns-spanned="7" office:value-type="string"><text:p>The instalments</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row table:style-name="rh0_75"><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p>Instalment</text:p></table:table-cell><table:table-cell table:style-name="ColHeadRight" office:value-type="string"><text:p>Payment date</text:p></table:table-cell><table:table-cell table:style-name="ColHeadRight" office:value-type="string"><text:p>Amount</text:p></table:table-cell><table:table-cell table:style-name="ColHeadRight" office:value-type="string"><text:p>Running total</text:p></table:table-cell><table:table-cell table:style-name="ColHeadPad" table:number-columns-spanned="2" office:value-type="string"><text:p>Report to be accepted first</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="ColHeadRight" office:value-type="string"><text:p>Report due</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="rh0_62"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Instalment 1</text:p></table:table-cell><table:table-cell table:style-name="RowDateIn" office:value-type="date" office:date-value="2027-01-01"><text:p>1 January 2027</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="15000.0"><text:p>£15,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.$C$7:.C7])" office:value-type="currency" office:currency="GBP" office:value="15000.0"><text:p>£15,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowPad" table:number-columns-spanned="2" office:value-type="string"><text:p>None: the first instalment is paid on the start date</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="Row"><text:p/></table:table-cell></table:table-row>
        <table:table-row table:style-name="rh0_62"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Instalment 2</text:p></table:table-cell><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B7];6)" office:value-type="date" office:date-value="2027-07-01"><text:p>1 July 2027</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="15000.0"><text:p>£15,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.$C$7:.C8])" office:value-type="currency" office:currency="GBP" office:value="30000.0"><text:p>£30,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowPad" table:number-columns-spanned="2" office:value-type="string"><text:p>Progress report 1: 1 January to 31 May 2027</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B8];-1)" office:value-type="date" office:date-value="2027-06-01"><text:p>1 June 2027</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="rh0_62"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Instalment 3</text:p></table:table-cell><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B8];6)" office:value-type="date" office:date-value="2028-01-01"><text:p>1 January 2028</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="15000.0"><text:p>£15,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.$C$7:.C9])" office:value-type="currency" office:currency="GBP" office:value="45000.0"><text:p>£45,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowPad" table:number-columns-spanned="2" office:value-type="string"><text:p>Progress report 2: 1 June to 30 November 2027</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B9];-1)" office:value-type="date" office:date-value="2027-12-01"><text:p>1 December 2027</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="rh0_62"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Instalment 4</text:p></table:table-cell><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B9];6)" office:value-type="date" office:date-value="2028-07-01"><text:p>1 July 2028</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="15000.0"><text:p>£15,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.$C$7:.C10])" office:value-type="currency" office:currency="GBP" office:value="60000.0"><text:p>£60,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowPad" table:number-columns-spanned="2" office:value-type="string"><text:p>Progress report 3: 1 December 2027 to 31 May 2028</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B10];-1)" office:value-type="date" office:date-value="2028-06-01"><text:p>1 June 2028</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="rh0_62"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Instalment 5</text:p></table:table-cell><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B10];6)" office:value-type="date" office:date-value="2029-01-01"><text:p>1 January 2029</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="15000.0"><text:p>£15,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.$C$7:.C11])" office:value-type="currency" office:currency="GBP" office:value="75000.0"><text:p>£75,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowPad" table:number-columns-spanned="2" office:value-type="string"><text:p>Progress report 4: 1 June to 30 November 2028</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B11];-1)" office:value-type="date" office:date-value="2028-12-01"><text:p>1 December 2028</text:p></table:table-cell></table:table-row>
        <table:table-row table:style-name="rh0_62"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Instalment 6</text:p></table:table-cell><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B11];6)" office:value-type="date" office:date-value="2029-07-01"><text:p>1 July 2029</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="15000.0"><text:p>£15,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.$C$7:.C12])" office:value-type="currency" office:currency="GBP" office:value="90000.0"><text:p>£90,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowPad" table:number-columns-spanned="2" office:value-type="string"><text:p>Progress report 5: 1 December 2028 to 31 May 2029</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="RowDate" table:formula="of:=EDATE([.B12];-1)" office:value-type="date" office:date-value="2029-06-01"><text:p>1 June 2029</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Total" office:value-type="string"><text:p>All six</text:p></table:table-cell><table:table-cell table:style-name="Total"><text:p/></table:table-cell><table:table-cell table:style-name="TotalMoney" table:formula="of:=SUM([.C7:.C12])" office:value-type="currency" office:currency="GBP" office:value="90000.0"><text:p>£90,000.00</text:p></table:table-cell><table:table-cell table:style-name="Total"><text:p/></table:table-cell><table:table-cell table:style-name="Total" table:number-columns-spanned="3"><text:p/></table:table-cell><table:covered-table-cell table:number-columns-repeated="2"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Section" table:number-columns-spanned="7" office:value-type="string"><text:p>The evening programme’s budget for each year</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="ColHead" office:value-type="string"><text:p></text:p></table:table-cell><table:table-cell table:style-name="ColHeadRight" office:value-type="float" office:value="2027.0"><text:p>2027</text:p></table:table-cell><table:table-cell table:style-name="ColHeadRight" office:value-type="float" office:value="2028.0"><text:p>2028</text:p></table:table-cell><table:table-cell table:style-name="ColHeadRight" office:value-type="float" office:value="2029.0"><text:p>2029</text:p></table:table-cell><table:table-cell table:style-name="ColHeadRight" office:value-type="string"><text:p>Three years</text:p></table:table-cell><table:table-cell table:style-name="ColHead" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Youth worker, three days a week</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="21000.0"><text:p>£21,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.B17]" office:value-type="currency" office:currency="GBP" office:value="21000.0"><text:p>£21,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.C17]" office:value-type="currency" office:currency="GBP" office:value="21000.0"><text:p>£21,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.B17:.D17])" office:value-type="currency" office:currency="GBP" office:value="63000.0"><text:p>£63,000.00</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Sessional workers</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="6000.0"><text:p>£6,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.B18]" office:value-type="currency" office:currency="GBP" office:value="6000.0"><text:p>£6,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.C18]" office:value-type="currency" office:currency="GBP" office:value="6000.0"><text:p>£6,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.B18:.D18])" office:value-type="currency" office:currency="GBP" office:value="18000.0"><text:p>£18,000.00</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Activities and trips</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="3000.0"><text:p>£3,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.B19]" office:value-type="currency" office:currency="GBP" office:value="3000.0"><text:p>£3,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.C19]" office:value-type="currency" office:currency="GBP" office:value="3000.0"><text:p>£3,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.B19:.D19])" office:value-type="currency" office:currency="GBP" office:value="9000.0"><text:p>£9,000.00</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Sub" office:value-type="string"><text:p>Paid for by the grant</text:p></table:table-cell><table:table-cell table:style-name="SubMoney" table:formula="of:=SUM([.B17:.B19])" office:value-type="currency" office:currency="GBP" office:value="30000.0"><text:p>£30,000.00</text:p></table:table-cell><table:table-cell table:style-name="SubMoney" table:formula="of:=SUM([.C17:.C19])" office:value-type="currency" office:currency="GBP" office:value="30000.0"><text:p>£30,000.00</text:p></table:table-cell><table:table-cell table:style-name="SubMoney" table:formula="of:=SUM([.D17:.D19])" office:value-type="currency" office:currency="GBP" office:value="30000.0"><text:p>£30,000.00</text:p></table:table-cell><table:table-cell table:style-name="SubMoney" table:formula="of:=SUM([.B20:.D20])" office:value-type="currency" office:currency="GBP" office:value="90000.0"><text:p>£90,000.00</text:p></table:table-cell><table:table-cell table:style-name="Sub" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row table:style-name="rh0_9"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Match funding from the Trust: the centre’s running costs for the evening sessions</text:p></table:table-cell><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="10000.0"><text:p>£10,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.B21]" office:value-type="currency" office:currency="GBP" office:value="10000.0"><text:p>£10,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.C21]" office:value-type="currency" office:currency="GBP" office:value="10000.0"><text:p>£10,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.B21:.D21])" office:value-type="currency" office:currency="GBP" office:value="30000.0"><text:p>£30,000.00</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Total" office:value-type="string"><text:p>Total cost of the evening programme</text:p></table:table-cell><table:table-cell table:style-name="TotalMoney" table:formula="of:=[.B20]+[.B21]" office:value-type="currency" office:currency="GBP" office:value="40000.0"><text:p>£40,000.00</text:p></table:table-cell><table:table-cell table:style-name="TotalMoney" table:formula="of:=[.C20]+[.C21]" office:value-type="currency" office:currency="GBP" office:value="40000.0"><text:p>£40,000.00</text:p></table:table-cell><table:table-cell table:style-name="TotalMoney" table:formula="of:=[.D20]+[.D21]" office:value-type="currency" office:currency="GBP" office:value="40000.0"><text:p>£40,000.00</text:p></table:table-cell><table:table-cell table:style-name="TotalMoney" table:formula="of:=SUM([.B22:.D22])" office:value-type="currency" office:currency="GBP" office:value="120000.0"><text:p>£120,000.00</text:p></table:table-cell><table:table-cell table:style-name="Total" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row table:style-name="rh0_9"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Check: grant instalments paid in the year</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUMPRODUCT((YEAR([.$B$7:.$B$12])=[.B16])*[.$C$7:.$C$12])" office:value-type="currency" office:currency="GBP" office:value="30000.0"><text:p>£30,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUMPRODUCT((YEAR([.$B$7:.$B$12])=[.C16])*[.$C$7:.$C$12])" office:value-type="currency" office:currency="GBP" office:value="30000.0"><text:p>£30,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUMPRODUCT((YEAR([.$B$7:.$B$12])=[.D16])*[.$C$7:.$C$12])" office:value-type="currency" office:currency="GBP" office:value="30000.0"><text:p>£30,000.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=SUM([.B24:.D24])" office:value-type="currency" office:currency="GBP" office:value="90000.0"><text:p>£90,000.00</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row table:style-name="rh0_9"><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Difference between the grant’s costs and the instalments</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.B20]-[.B24]" office:value-type="currency" office:currency="GBP" office:value="0.0"><text:p>£0.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.C20]-[.C24]" office:value-type="currency" office:currency="GBP" office:value="0.0"><text:p>£0.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.D20]-[.D24]" office:value-type="currency" office:currency="GBP" office:value="0.0"><text:p>£0.00</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=[.E20]-[.E24]" office:value-type="currency" office:currency="GBP" office:value="0.0"><text:p>£0.00</text:p></table:table-cell><table:table-cell table:style-name="Row" table:number-columns-spanned="2"><text:p/></table:table-cell><table:covered-table-cell/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="7"/></table:table-row>
        <table:table-row table:style-name="rh0_95"><table:table-cell table:style-name="NoteWrap" table:number-columns-spanned="7" office:value-type="string"><text:p>The Trust must find £10,000 a year of match funding, which is £30,000 over the three years. The final report on the grant is due after 31 December 2029 and does not hold up any instalment.</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="6"/></table:table-row>
      </table:table>
    </office:spreadsheet>
  </office:body>
</office:document>
