<?xml version="1.0" encoding="UTF-8"?>
<!--
  The payments and budget sheet for the Wexmoor Foundation's grant to Marsh Lane Community Trust (1004.1 Drafts), prepared by
  Jamie Clarke on 1 October 2026 from the draft grant agreement of 24 September 2026. Every result is a real formula, and each
  formula cell also carries the value it works out to (office:value), which LibreOffice shows until it recalculates. If a figure
  changes, change the cached value beside it. The sums, for checking by hand:

    six instalments of 15,000.00 on 1 Jan and 1 Jul 2027, 2028, 2029; running totals 15,000 ... 90,000
    each report is due a month before the instalment that waits for it: 1 Jun 2027, 1 Dec 2027, 1 Jun 2028, 1 Dec 2028, 1 Jun 2029
    each year: 21,000 + 6,000 + 3,000 = 30,000.00 of grant, plus 10,000.00 of match funding = 40,000.00; three years 90,000, 30,000, 120,000
    instalments paid in each calendar year: 15,000 x 2 = 30,000.00, which equals the grant's costs for the year, so each difference is nil
-->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
