        <table:table-row><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Unit 1</text:p></table:table-cell><table:table-cell table:style-name="RowPctIn" office:value-type="percentage" office:value="0.22"><text:p>22%</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=ROUND([.$C$18]*[.B22];2)" office:value-type="currency" office:currency="GBP" office:value="6630.8"><text:p>£6,630.80</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=ROUND([.C22]/4;2)" office:value-type="currency" office:currency="GBP" office:value="1657.7"><text:p>£1,657.70</text:p></table:table-cell></table:table-row>
