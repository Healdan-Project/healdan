        <table:table-row table:style-name="rh1_0"><table:table-cell table:style-name="NoteWrap" table:number-columns-spanned="4" office:value-type="string"><text:p>Issued by Harrow &amp; Lund, Commercial Agents, for Penwick Property Limited on 30 September 2026. Prepared by Fiona Lund. Figures are before VAT. Blue figures are inputs; the rest are worked out.</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="3"/></table:table-row>
        <table:table-row><table:table-cell table:number-columns-repeated="4"/></table:table-row>
        <table:table-row><table:table-cell table:style-name="Section" table:number-columns-spanned="4" office:value-type="string"><text:p>Estate costs for the year</text:p></table:table-cell><table:covered-table-cell table:number-columns-repeated="3"/></table:table-row>
