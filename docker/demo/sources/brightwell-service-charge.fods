        <table:table-row><table:table-cell table:style-name="HiRow" office:value-type="string"><text:p>Unit 4 (Brightwell Bakeries Ltd)</text:p></table:table-cell><table:table-cell table:style-name="HiPct" office:value-type="percentage" office:value="0.085"><text:p>8.5%</text:p></table:table-cell><table:table-cell table:style-name="HiMoney" table:formula="of:=ROUND([.$C$18]*[.B25];2)" office:value-type="currency" office:currency="GBP" office:value="2561.9"><text:p>£2,561.90</text:p></table:table-cell><table:table-cell table:style-name="HiMoney" table:formula="of:=ROUND([.C25]/4;2)" office:value-type="currency" office:currency="GBP" office:value="640.48"><text:p>£640.48</text:p></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" office:value-type="string"><text:p>Unit 5</text:p></table:table-cell><table:table-cell table:style-name="RowPctIn" office:value-type="percentage" office:value="0.165"><text:p>16.5%</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=ROUND([.$C$18]*[.B26];2)" office:value-type="currency" office:currency="GBP" office:value="4973.1"><text:p>£4,973.10</text:p></table:table-cell><table:table-cell table:style-name="RowMoney" table:formula="of:=ROUND([.C26]/4;2)" office:value-type="currency" office:currency="GBP" office:value="1243.28"><text:p>£1,243.28</text:p></table:table-cell></table:table-row>
