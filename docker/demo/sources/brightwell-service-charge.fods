<?xml version="1.0" encoding="UTF-8"?>
<!--
  The service charge budget for the Weir Lane Trading Estate for 1 October 2026 to 30 September 2027, issued by Harrow & Lund
  on 30 September 2026 (1002.1 Due Diligence). Every result is a real formula, and each formula cell also carries the
  value it works out to (office:value), which LibreOffice shows until it recalculates. If a figure changes, change the
  cached value beside it. The sums, for checking by hand:

    estate costs  6,200 + 3,800 + 2,400 + 1,100 + 9,600 + 850 + 1,450 + 2,000 = 27,400.00
    management fee  10% of 27,400.00 = 2,740.00; total 30,140.00
    Unit 1 22% 6,630.80; Unit 2 18% 5,425.20; Unit 3 15% 4,521.00; Unit 4 8.5% 2,561.90; Unit 5 16.5% 4,973.10;
    Unit 6 20% 6,028.00; together 30,140.00. Quarterly = yearly / 4, rounded to the penny.
-->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
