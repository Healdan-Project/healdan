        <table:table-row><table:table-cell table:style-name="Sub" table:number-columns-spanned="2" office:value-type="string"><text:p>Estate costs</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="SubMoney" table:formula="of:=SUM([.C7:.C14])" office:value-type="currency" office:currency="GBP" office:value="27400.0"><text:p>£27,400.00</text:p></table:table-cell><table:table-cell table:style-name="Sub"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="2" office:value-type="string"><text:p>Management fee, as a percentage of the estate costs</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="RowPctIn" office:value-type="percentage" office:value="0.1"><text:p>10%</text:p></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell></table:table-row>
        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="2" office:value-type="string"><text:p>Management fee</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="RowMoney" table:formula="of:=ROUND([.C15]*[.C16];2)" office:value-type="currency" office:currency="GBP" office:value="2740.0"><text:p>£2,740.00</text:p></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell></table:table-row>
