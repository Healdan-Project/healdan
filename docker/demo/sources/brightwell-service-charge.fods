        <table:table-row><table:table-cell table:style-name="Row" table:number-columns-spanned="2" office:value-type="string"><text:p>Estate road repairs</text:p></table:table-cell><table:covered-table-cell/><table:table-cell table:style-name="RowMoneyIn" office:value-type="currency" office:currency="GBP" office:value="6200.0"><text:p>£6,200.00</text:p></table:table-cell><table:table-cell table:style-name="Row"><text:p/></table:table-cell></table:table-row>
