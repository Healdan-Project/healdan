<?xml version="1.0" encoding="UTF-8"?>
<!--
  The lease plan for 1002.1 (Brightwell Bakeries Ltd, Unit 4, Weir Lane Trading Estate), drawing WL/04/01, as
  drawn by Penwick Property Limited's surveyors in August 2026. A4 landscape, simple labelled shapes, not to scale.
  North is up. Units 1 to 6 run west to east above the estate road, each with its yard in front; Unit 4 is edged
  red with its yard hatched, the loading bay and the bin store at the foot of the yard, and parking spaces 7 and 8
  (shaded) opposite it. Parking spaces 1 to 12 and the landscaped area lie between the road and Weir Lane.
-->
<office:document
  xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
