<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <!-- CI, the Docker build and local builds use this settings file. Healdan hosts the artifacts from LogicalDOC's
       repository and Alfresco's Jakarta OpenCMIS build. Terracotta supplies org.terracotta.internal:statistics.
       .github/scripts/check-maven-repositories.py checks declarations in project POMs and in this file. -->
  <mirrors>
    <!-- Upstream's POMs declare repositories for LogicalDOC's artifacts and Alfresco's Jakarta OpenCMIS build.
         The mirror matches their ids, so Maven resolves both sets of artifacts from Healdan's copies. -->
    <mirror>
      <id>healdan</id>
      <name>Healdan's copies of LogicalDOC and Jakarta OpenCMIS artifacts</name>
      <mirrorOf>logicaldoc,Alfresco Maven Repository</mirrorOf>
      <url>https://maven.healdan.com/</url>
    </mirror>
    <!-- These repositories supply no artifacts to the build. In #302, Eclipse's Retry-After response held up
         every OpenCMIS download from Alfresco. The last five ids belong to the samples outside the reactor. -->
    <mirror>
      <id>retired-repositories</id>
      <name>Maven Central in place of unused upstream repositories</name>
      <mirrorOf>java.net,sourceforge,eclipse-releases,google-api-services,mulesoft-public,maven2-repository.dev.java.net,smartgwt,gwtupload,gwtchismes,gwt-image-loader-repo</mirrorOf>
      <url>https://repo1.maven.org/maven2</url>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <id>with-extra-repos</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
        </repository>
        <!-- Terracotta supplies org.terracotta.internal:statistics:1.0.5 and its forge-parent POM. Healdan's
             mirror importer takes a JAR with its POM, and the parent is published on its own. -->
        <repository>
          <id>terracotta</id>
          <url>https://repo.terracotta.org/maven2</url>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>with-extra-repos</activeProfile>
  </activeProfiles>
</settings>
